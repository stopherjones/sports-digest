import fs from 'fs/promises';

// Configure teams with explicit sport and league identifiers
const TEAMS = [
  { id: '357', name: 'Leeds United', searchName: 'Leeds', sport: 'soccer', league: 'eng.1' },
  { id: '383', name: 'York City', searchName: 'York City', sport: 'soccer', league: 'eng.4' },
